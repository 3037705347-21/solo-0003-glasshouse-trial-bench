{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "rootDir": "../..",
    "outDir": "../../../dist-test",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["./**/*.ts", "../../domain/**/*.ts"],
  "exclude": ["./**/*.tsx"]
}
